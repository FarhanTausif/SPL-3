        <mxCell id="worker" value="&lt;b&gt;Background Worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;PostgreSQL queue consumer&lt;br&gt;Leases + heartbeat + concurrency&lt;br&gt;&lt;br&gt;DeHaluPipeline orchestrator&lt;br&gt;Intake → local code generation&lt;br&gt;Claims → static checks → metrics&lt;br&gt;Judges → consensus → CoVe&lt;br&gt;Policy → accept / warn / reject&lt;br&gt;Repair → full re-verification&lt;br&gt;&lt;br&gt;Stage checkpoints + event journal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
