        <mxCell id="worker-boundary" value="&lt;b&gt;INSIDE THE BACKGROUND WORKER · DeHaluPipeline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=15;spacing=12;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingTop=12;" vertex="1" parent="1">
