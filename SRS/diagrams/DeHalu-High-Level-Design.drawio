        <mxCell id="subtitle" value="&lt;b&gt;Actual pipeline order · static analyzers run sequentially · judge-provider calls run in parallel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
