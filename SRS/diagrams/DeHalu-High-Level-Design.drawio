          <mxGeometry x="80" y="410" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="static" value="&lt;b&gt;3 · Execution-Free Static Detection&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Tree-sitter / Python AST&lt;br&gt;Syntax + incomplete structures&lt;br&gt;&lt;br&gt;Semgrep / local SAST rules&lt;br&gt;Unsafe patterns + resource / quality issues&lt;br&gt;&lt;br&gt;Symbol Indexer + Package / API Validator&lt;br&gt;References + signatures + local catalogs&lt;br&gt;Optional package-registry evidence&lt;br&gt;&lt;br&gt;Collect findings + analyzer coverage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#0F172A;fontFamily=Helvetica;fontSize=16;spacing=12;" vertex="1" parent="1">
