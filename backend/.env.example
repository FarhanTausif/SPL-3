# DeHalu Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DEHALU_DATABASE_URL=postgresql+psycopg://dehalu:dehalu@localhost:5432/dehalu

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEHALU_APP_NAME=DeHalu Backend
DEHALU_APP_VERSION=0.1.0
DEHALU_ENVIRONMENT=development

# =============================================================================
# ORCHESTRATION SETTINGS
# =============================================================================
# Mode: 'direct' for simple synchronous execution, 'crewai' for CrewAI-based orchestration
DEHALU_ORCHESTRATION_MODE=direct

# Default provider: 'auto' (auto-select), 'fake' (testing), or specific provider name
DEHALU_DEFAULT_PROVIDER=auto

# Default language for code generation
DEHALU_DEFAULT_LANGUAGE=python

# Latency budget in seconds
DEHALU_DEFAULT_LATENCY_BUDGET_SECONDS=15

# =============================================================================
# POLICY VERSIONS
# =============================================================================
DEHALU_ROUTING_POLICY_VERSION=v1
DEHALU_PROMPT_POLICY_VERSION=v1

# =============================================================================
# PROVIDER API KEYS (Required for live provider operation)
# =============================================================================
# Get your API keys from:
# - Gemini: https://aistudio.google.com/apikey
# - Groq: https://console.groq.com/keys
# - Mistral: https://console.mistral.ai/api-keys/
# - Cerebras: https://cloud.cerebras.ai/

DEHALU_GEMINI_API_KEY=your_gemini_api_key_here
DEHALU_GROQ_API_KEY=your_groq_api_key_here
DEHALU_MISTRAL_API_KEY=your_mistral_api_key_here
DEHALU_CEREBRAS_API_KEY=your_cerebras_api_key_here

# =============================================================================
# PROVIDER CONFIGURATION (Optional - defaults shown)
# =============================================================================

# Gemini Configuration
DEHALU_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEHALU_GEMINI_GENERATE_MODEL=gemini-2.0-flash
DEHALU_GEMINI_VERIFY_MODEL=gemini-2.0-flash
DEHALU_GEMINI_TIMEOUT_SECONDS=15.0
DEHALU_GEMINI_RETRY_ATTEMPTS=1

# Groq Configuration
DEHALU_GROQ_BASE_URL=https://api.groq.com/openai/v1
DEHALU_GROQ_GENERATE_MODEL=llama-3.1-8b
DEHALU_GROQ_VERIFY_MODEL=llama-3.1-8b
DEHALU_GROQ_TIMEOUT_SECONDS=15.0
DEHALU_GROQ_RETRY_ATTEMPTS=1

# Mistral Configuration
DEHALU_MISTRAL_BASE_URL=https://api.mistral.ai/v1
DEHALU_MISTRAL_GENERATE_MODEL=codestral-2508
DEHALU_MISTRAL_VERIFY_MODEL=mistral-large-2512
DEHALU_MISTRAL_TIMEOUT_SECONDS=15.0
DEHALU_MISTRAL_RETRY_ATTEMPTS=1

# Cerebras Configuration
DEHALU_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
DEHALU_CEREBRAS_GENERATE_MODEL=llama3.1-8b
DEHALU_CEREBRAS_VERIFY_MODEL=llama3.1-8b
DEHALU_CEREBRAS_TIMEOUT_SECONDS=15.0
DEHALU_CEREBRAS_RETRY_ATTEMPTS=1

# =============================================================================
# PROVIDER ORDERING (JSON arrays for each role)
# =============================================================================
DEHALU_CLARIFICATION_PROVIDER_ORDER=["gemini","mistral"]
DEHALU_GENERATION_PROVIDER_ORDER=["groq","gemini"]
DEHALU_JUDGE_PROVIDER_ORDER=["gemini","mistral","cerebras"]
DEHALU_COVE_PROVIDER_ORDER=["mistral","gemini"]
DEHALU_REPAIR_PROVIDER_ORDER=["gemini","mistral","cerebras","groq"]

# =============================================================================
# WORKER CONFIGURATION (For advanced/worker-backed mode)
# =============================================================================
DEHALU_WORKER_ID=dehalu-worker-1
DEHALU_WORKER_POLL_INTERVAL_SECONDS=1.0
DEHALU_WORKER_LEASE_SECONDS=30
DEHALU_WORKER_MAX_RETRIES=3
DEHALU_WORKER_BATCH_SIZE=1

# =============================================================================
# LIVE PROVIDER SMOKE CHECKS
# =============================================================================
# Enable to validate provider connectivity on startup
DEHALU_PROVIDER_LIVE_SMOKE_CHECKS_ENABLED=false

# Capture full request/response payloads for debugging (useful for development)
DEHALU_PROVIDER_CAPTURE_FULL_PAYLOADS=false

# Provider health check timeout in seconds
DEHALU_PROVIDER_HEALTH_TIMEOUT_SECONDS=2.0
