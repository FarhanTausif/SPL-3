# ============================================================================
# DeHalu CrewAI Agent System - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual API keys and settings.
# This template includes all configuration needed for CrewAI-based execution,
# real provider integration, and comprehensive observability.
# 
# Reference: See System_Design.md for agent role definitions and
# System_Architecture.md for component responsibilities.
# ============================================================================

# Database Configuration
# =====================
# PostgreSQL connection string for persistent run storage and evidence tracking.
# Format: postgresql+psycopg://user:password@host:port/database
DEHALU_DATABASE_URL=postgresql+psycopg://dehalu:dehalu@localhost:5432/dehalu

# Orchestration Mode
# ==================
# Options: 
#   direct    - Single-process synchronous execution (development, fast feedback)
#   crewai    - Multi-agent CrewAI execution with full workflow orchestration (production)
#   advanced  - Worker-backed async with queue (for distributed setup)
DEHALU_ORCHESTRATION_MODE=crewai

# CrewAI-Specific Settings
# ========================
# Control CrewAI agent behavior and execution characteristics.
# Verbose mode produces detailed logs of agent reasoning and decisions.
DEHALU_CREWAI_VERBOSE_MODE=true
DEHALU_CREWAI_MEMORY_ENABLED=true
DEHALU_CREWAI_MEMORY_TYPE=short_term
DEHALU_CREWAI_CACHE_ENABLED=true
DEHALU_CREWAI_CACHE_TYPE=semantic
DEHALU_CREWAI_MAX_RETRIES=2
DEHALU_CREWAI_TIMEOUT_SECONDS=300

# Provider API Keys & Configuration
# ==================================
# Obtain keys from each provider's console. Free tier options available.
# 
# GEMINI: https://ai.google.dev (free tier: 60 requests/min, $0.075/$0.30 per M tokens)
DEHALU_GEMINI_API_KEY=your-gemini-api-key-here
DEHALU_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
DEHALU_GEMINI_MODEL=gemini-2.0-flash-exp
DEHALU_GEMINI_ENABLED=true

# GROQ: https://console.groq.com/keys (free tier available)
DEHALU_GROQ_API_KEY=your-groq-api-key-here
DEHALU_GROQ_BASE_URL=https://api.groq.com/openai/v1
DEHALU_GROQ_MODEL=llama3.1-8b
DEHALU_GROQ_ENABLED=true

# MISTRAL: https://console.mistral.ai (free tier: $0.14/$0.42 per M tokens)
DEHALU_MISTRAL_API_KEY=your-mistral-api-key-here
DEHALU_MISTRAL_BASE_URL=https://api.mistral.ai/v1
DEHALU_MISTRAL_MODEL=mistral-large-2512
DEHALU_MISTRAL_ENABLED=true

# CEREBRAS: https://inference.cerebras.ai (free: 10K tokens/month, $0.00012/$0.00024 per token)
DEHALU_CEREBRAS_API_KEY=your-cerebras-api-key-here
DEHALU_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
DEHALU_CEREBRAS_MODEL=llama-3.1-8b
DEHALU_CEREBRAS_ENABLED=true

# Fallback Provider (for testing without real keys)
# =================================================
# Set to 'fake' to use deterministic mock provider (returns canned responses)
# Set to 'gemini', 'groq', 'mistral', or 'cerebras' for production
DEHALU_PRIMARY_PROVIDER=crewai
DEHALU_FALLBACK_PROVIDER=fake

# Policy Versions
# ===============
# Control which policy rule sets are active.
# Update when policy rules change (e.g., new hallucination detection heuristics)
DEHALU_ROUTING_POLICY_VERSION=v1
DEHALU_PROMPT_POLICY_VERSION=v1
DEHALU_REPAIR_POLICY_VERSION=v1

# Provider Health & Monitoring
# =============================
# Enable smoke tests at startup to verify provider connectivity
# Enable full payload capture for debugging (increases memory usage)
DEHALU_PROVIDER_LIVE_SMOKE_CHECKS_ENABLED=false
DEHALU_PROVIDER_CAPTURE_FULL_PAYLOADS=false

# Logging & Observability
# ========================
# Structured logging via structlog (JSON output)
DEHALU_LOG_LEVEL=INFO
DEHALU_LOG_FORMAT=json
DEHALU_STRUCTLOG_ENABLE_COLORS=false
DEHALU_STRUCTLOG_CACHE_LOGGER_ON_FIRST_USE=true

# Execution Tracing (for debugging and audit trails)
DEHALU_ENABLE_EXECUTION_TRACING=true
DEHALU_TRACE_OUTPUT_DIR=./artifacts/traces
DEHALU_CAPTURE_EVIDENCE_DETAILS=true

# Worker Configuration (for advanced/worker-backed mode)
# ========================================================
# Only used if DEHALU_ORCHESTRATION_MODE=advanced
DEHALU_WORKER_LEASE_DURATION_SECONDS=30
DEHALU_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
DEHALU_WORKER_MAX_CONCURRENT_RUNS=5
DEHALU_WORKER_QUEUE_POLL_INTERVAL_SECONDS=5

# Sandbox Execution
# =================
# Configure code execution sandboxing (used by SandboxExecutionTask)
DEHALU_SANDBOX_TIMEOUT_SECONDS=30
DEHALU_SANDBOX_MEMORY_LIMIT_MB=512
DEHALU_SANDBOX_CPU_LIMIT_PERCENT=80
DEHALU_SANDBOX_NETWORK_ENABLED=false
DEHALU_SANDBOX_FILE_SYSTEM_READONLY=true

# Verification Pipeline Thresholds
# ==================================
# Control when mitigation (repair) is triggered
# (See System_Design.md for detailed semantics)
DEHALU_VERIFICATION_CLAIM_EXTRACTION_MIN_CONFIDENCE=0.7
DEHALU_VERIFICATION_STATIC_ANALYSIS_HARD_FAIL_ON_SYNTAX_ERROR=true
DEHALU_VERIFICATION_JUDGE_CONSENSUS_THRESHOLD=0.75
DEHALU_VERIFICATION_REPAIR_TRIGGER_ON_EXECUTION_FAILURE=true
DEHALU_VERIFICATION_REPAIR_TRIGGER_ON_IMPORT_ERROR=true
DEHALU_VERIFICATION_MAX_REPAIR_ATTEMPTS=1

# Testing & Development
# ======================
# Use fake provider for rapid iteration (no API calls, deterministic responses)
DEHALU_USE_FAKE_PROVIDER_FOR_TESTING=false
DEHALU_DEVELOPMENT_MODE=false

# Performance Tuning
# ==================
# Parallelism in verification pipeline (claims, static, sandbox can run in parallel)
DEHALU_VERIFICATION_PARALLEL_ANALYSIS_ENABLED=true
DEHALU_VERIFICATION_PARALLEL_JUDGE_EXECUTION_ENABLED=true
DEHALU_DATABASE_POOL_SIZE=20
DEHALU_DATABASE_MAX_OVERFLOW=10

# ============================================================================
# Quick Start
# ============================================================================
# 1. Set DEHALU_DATABASE_URL to your PostgreSQL instance
# 2. Set provider API keys (at least one of GEMINI, GROQ, MISTRAL, CEREBRAS)
# 3. Set DEHALU_ORCHESTRATION_MODE=crewai for multi-agent execution
# 4. Run: alembic upgrade head (to initialize database schema)
# 5. Run: uvicorn dehalu.core.app:app --reload (to start API server)
# 6. Test: curl http://localhost:8000/health (should return provider availability)
#
# See backend/docs/TESTING_CREWAI_AGENTS.md for detailed testing strategies
# and cost optimization tips.
# ============================================================================
